// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}


datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_MASTER
  MASTER
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum OrderPackageType {
  XXS
  XS
  S
  M
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PICKED
  IN_TRANSIT
  RETURNING
  RETURNED
}

enum AliclikSyncStatus {
  NOT_SYNCED
  SYNCED
  ERROR
}

enum WalletTopUpStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum AliclikSyncAction {
  QUOTE
  CREATE
  UPDATE
  CONFIRM
  RESCHEDULE
  CANCEL
  LOOKUP
}

model User {
  id                             String              @id @default(cuid())
  email                          String              @unique
  passwordHash                   String
  role                           Role                @default(MASTER)
  isEmailVerified                Boolean             @default(false)
  emailVerifiedAt                DateTime?
  refreshTokenHash               String?
  emailVerificationCodeHash      String?
  emailVerificationCodeExpiresAt DateTime?
  passwordResetCodeHash          String?
  passwordResetCodeExpiresAt     DateTime?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  paymentPhone                   String?
  paymentMethod                  String?
  bank                           String?
  bankAccountNumber              String?
  bankHolderName                 String?
  yapeHolderName                 String?
  supportPhone                   String?
  aliclikUserCreated             Boolean             @default(false)
  aliclikUserId                  Int?
  storeName                      String?
  documentNumber                 String?
  defaultOrigin                  String?
  defaultOriginLat               Decimal?
  defaultOriginLng               Decimal?
  defaultOriginDepartment        String?
  defaultOriginProvince          String?
  defaultOriginDistrict          String?
  aliclikWarehouseId             String?
  aliclikProductSkuId            String?
  aliclikProductEan              String?

  wallet                         Wallet?
  walletTransactionsPerformed    WalletTransaction[] @relation("WalletTransactionActor")
  orders                         Order[]
  orderStatusHistoryPerformed    OrderStatusHistory[] @relation("OrderStatusHistoryActor")

  @@map("users")
}

model Wallet {
  id        String    @id @default(cuid())
  userId    String    @unique
  balance   Decimal   @db.Decimal(20, 2) @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  topUps       WalletTopUp[]

  @@map("wallets")
}

model WalletTransaction {
  id           String               @id @default(cuid())
  walletId     String
  actorUserId  String
  orderId      String?              @unique
  type         WalletTransactionType
  amount       Decimal              @db.Decimal(20, 2)
  reason       String
  balanceAfter Decimal              @db.Decimal(20, 2)
  createdAt    DateTime             @default(now())

  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  actorUser User   @relation("WalletTransactionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  order     Order? @relation("OrderDeliveredChargeTransaction", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model Order {
  id                          String               @id @default(cuid())
  userId                      String
  packageType                 OrderPackageType
  status                      OrderStatus          @default(PENDING)
  origin                      String
  destination                 String
  recipientFullName           String
  recipientPhone              String
  note                        String?
  weightGrams                 Int                  @default(0)
  collectionAmount            Decimal?             @db.Decimal(10, 2)
  originLat                   Decimal?             @db.Decimal(10, 7)
  originLng                   Decimal?             @db.Decimal(10, 7)
  destinationLat              Decimal?             @db.Decimal(10, 7)
  destinationLng              Decimal?             @db.Decimal(10, 7)
  aliclikOrderNumber          String?              @unique
  aliclikSyncStatus           AliclikSyncStatus    @default(NOT_SYNCED)
  aliclikLastSyncAction       AliclikSyncAction?
  aliclikLastSyncAttemptAt    DateTime?
  aliclikSyncedAt             DateTime?
  aliclikLastSyncError        String?
  aliclikWebhookStatus        String?
  aliclikWebhookDispatchStatus String?
  aliclikWebhookCallStatus    String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  labelGeneratedAt            DateTime?

  user                        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory               OrderStatusHistory[]
  deliveredChargeTransaction   WalletTransaction?   @relation("OrderDeliveredChargeTransaction")
  aliclikEvidences             AliclikOrderEvidence[]
  aliclikPayments               AliclikOrderPayment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model AliclikOrderEvidence {
  id               String    @id @default(cuid())
  orderId          String
  remoteId         Int
  deliveryStatus   String?
  subStatus        String?
  comment          String?
  evidenceDelivery String?
  evidenceSupport  String?
  evidenceCall     String?
  evidenceChat     String?
  evidenceCallChat String?
  method           String?
  deliveryDate     DateTime?
  remoteCreatedAt  DateTime?
  fetchedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, remoteId])
  @@index([orderId])
  @@map("aliclik_order_evidences")
}

model AliclikOrderPayment {
  id                    String    @id @default(cuid())
  orderId               String
  remoteId              String
  amount                Decimal   @db.Decimal(10, 2)
  paymentMethod         String?
  entity                String?
  paymentDate           DateTime?
  paymentDocument       String?
  status                String
  orderDeliveryRemoteId Int?
  remoteCreatedAt       DateTime?
  fetchedAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, remoteId])
  @@index([orderId])
  @@map("aliclik_order_payments")
}

model WalletTopUp {
  id              String            @id @default(cuid())
  walletId        String
  userId          String
  cobranaChargeId String?           @unique
  cobranaEventId  String?           @unique
  amount          Decimal           @db.Decimal(10, 2)
  status          WalletTopUpStatus @default(PENDING)
  cobranaCode     String?
  paymentUrl      String?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("wallet_top_ups")
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedByUserId String
  createdAt       DateTime    @default(now())

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User        @relation("OrderStatusHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)])
  @@index([changedByUserId, createdAt(sort: Desc)])
  @@map("order_status_history")
}
